# Copy to the repository root as `.env.local-agentteams` and chmod 600.
# Never commit the real file.
DEEPSEEK_API_KEY=replace-with-deepseek-key
PIXCAKE_PROVIDERS_DEEPSEEK_API_KEY=replace-with-the-same-deepseek-key
HICLAW_LLM_API_KEY=replace-with-the-same-deepseek-key

# `scripts/local_demo.sh setup` aligns these with the three AgentTeams/Higress
# consumer identities after installation. Initial random values are sufficient.
AGENTRIG_MANAGER_MCP_TOKEN=replace-with-random-manager-token
AGENTRIG_CURATOR_MCP_TOKEN=replace-with-random-curator-token
AGENTRIG_JUDGE_MCP_TOKEN=replace-with-random-judge-token

HICLAW_ADMIN_USER=admin
HICLAW_ADMIN_PASSWORD=replace-with-random-admin-password
HICLAW_LLM_PROVIDER=openai-compat
HICLAW_OPENAI_BASE_URL=https://api.deepseek.com
HICLAW_DEFAULT_MODEL=deepseek-v4-flash
HICLAW_EMBEDDING_MODEL=
HICLAW_MODEL_CONTEXT_WINDOW=1000000
HICLAW_MODEL_MAX_TOKENS=8192
HICLAW_MODEL_REASONING=false
HICLAW_MODEL_VISION=false
HICLAW_MANAGER_RUNTIME=openclaw
HICLAW_DEFAULT_WORKER_RUNTIME=openclaw
HICLAW_MATRIX_E2EE=0
HICLAW_VERSION=v1.1.2
HICLAW_LANGUAGE=zh
HICLAW_LOCAL_ONLY=1
HICLAW_PORT_GATEWAY=18080
HICLAW_PORT_CONSOLE=18001
HICLAW_PORT_ELEMENT_WEB=18088
HICLAW_PORT_MANAGER_CONSOLE=18888
HICLAW_MATRIX_DOMAIN=matrix-local.hiclaw.io:18080
HICLAW_MATRIX_CLIENT_DOMAIN=matrix-local.hiclaw.io:18080
HICLAW_AI_GATEWAY_DOMAIN=aigw-local.hiclaw.io
HICLAW_FS_DOMAIN=fs-local.hiclaw.io
HICLAW_CONSOLE_DOMAIN=console-local.hiclaw.io
HICLAW_MOUNT_SOCKET=1
HICLAW_DOCKER_PROXY=0
HICLAW_WORKER_IDLE_TIMEOUT=720
